[Unit]
Description=ScoreRoom API (Spring Boot)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=scoreroom
Group=scoreroom
# DB 접속 정보 등 비밀값. 저장소에 넣지 않고 서버에만 둔다 (root 전용 600)
EnvironmentFile=/etc/scoreroom/scoreroom.env
WorkingDirectory=/var/lib/scoreroom
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/scoreroom/current/app.jar
# Spring Boot는 SIGTERM에 143으로 끝난다 (정상 종료로 본다)
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=40

# 권한 최소화: 쓰기는 /var/lib/scoreroom(업로드)만
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scoreroom

[Install]
WantedBy=multi-user.target
