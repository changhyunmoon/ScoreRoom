# /etc/scoreroom/scoreroom.env (root 전용, 권한 600). CHANGE_ME를 실제 값으로 바꾼다.
# 이 파일의 실제 값은 저장소나 GitHub에 올리지 않는다.

SPRING_PROFILES_ACTIVE=prod
# Nginx만 API에 접근하도록 로컬에만 연다
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/scoreroom
DB_USERNAME=scoreroom
DB_PASSWORD=CHANGE_ME

# 발표 자료 저장 위치 (DB와 함께 백업한다)
UPLOAD_DIR=/var/lib/scoreroom/uploads

# 최초 시스템 관리자: 시스템 관리자가 한 명도 없을 때 한 번만 만든다. 만든 뒤에는 지워도 된다
SCOREROOM_ADMIN_LOGIN_ID=CHANGE_ME
SCOREROOM_ADMIN_PASSWORD=CHANGE_ME

# http로 운영하므로 false. 나중에 HTTPS를 붙이면 true로 바꾼다 (true인데 http로 접속하면 로그인이 안 된다)
SCOREROOM_SESSION_SECURECOOKIE=false

JAVA_OPTS=-Xms256m -Xmx1g
